# Environment variables for Square One Rentals
# Contact the project owner for the actual values of these environment variables

# MongoDB Connection
MONGODB_URI=Contact project owner for the connection string

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=Contact project owner for the secret

# Google OAuth
GOOGLE_CLIENT_ID=Contact project owner for the client ID
GOOGLE_CLIENT_SECRET=Contact project owner for the client secret

# Cloudinary Configuration
CLOUDINARY_URL=Contact project owner for the Cloudinary URL

# Other Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
